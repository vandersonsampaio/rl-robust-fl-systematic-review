# Normalize every text file to LF in the repository and in checkouts
* text=auto eol=lf

# Data and documents
*.csv text eol=lf
*.tsv text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.tex text eol=lf
*.svg text eol=lf
*.cff text eol=lf

# Code
*.py  text eol=lf diff=python

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.xlsx binary
